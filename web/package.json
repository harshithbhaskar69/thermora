{
  "name": "thermora-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "test": "vitest run src tooling",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0 && oxlint --jsx-a11y-plugin --deny jsx-a11y --allow jsx-a11y/prefer-tag-over-role --deny-warnings src e2e ui && stylelint 'src/**/*.css' 'public/**/*.css' '../internal/manufacturer/assets/*.css' --max-warnings=0",
    "format": "cd .. && web/node_modules/.bin/prettier --write . --ignore-unknown",
    "format:check": "cd .. && web/node_modules/.bin/prettier --check . --ignore-unknown",
    "test:ui": "playwright test --config=playwright.ui.config.ts"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.2",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router": "7.18.4",
    "swagger-ui-dist": "5.33.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui": "5.32.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "squawk-cli": "2.66.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
